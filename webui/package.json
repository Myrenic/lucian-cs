{
  "name": "lucian-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LUCIAN (luciancs.nl) rebuilt as a shadcn/ui site - Vite, React and Tailwind",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --emptyOutDir && node scripts/prerender.mjs && node scripts/build-configmap.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "import": "node scripts/import-content.mjs",
    "ssr": "vite build --ssr src/entry-server.tsx --emptyOutDir"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.9.6",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "css-select": "^7.0.0",
    "domutils": "^4.0.2",
    "htmlparser2": "^12.0.0",
    "tailwindcss": "^4",
    "typescript": "~6",
    "vite": "^8"
  }
}
